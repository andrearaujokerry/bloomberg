{
  "name": "@terminal/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify HTTP + WebSocket plant, Postgres access, providers, ingest, functions.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@terminal/core": "*",
    "@terminal/sdk": "*",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "undici": "^7.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0"
  }
}
