{
  "name": "@terminal/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure domain: types, enums, schemas, field dictionary, analytics. No IO.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "zod": "^4.0.0"
  }
}
