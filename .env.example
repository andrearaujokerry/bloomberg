DATABASE_URL=postgres://localhost:5432/bloomberg_dev
DATABASE_URL_TEST=postgres://localhost:5432/bloomberg_test
DATABASE_URL_MAINT=postgres://terminal_maint@localhost:5432/bloomberg_dev
PORT=8080
PROVIDER_MODE=replay
REPLAY_DIR=./fixtures/providers
SEC_USER_AGENT="Terminal Clone dev (andre.araujo.kerry@gmail.com)"
OPENFIGI_API_KEY=
FRED_API_KEY=
BLS_API_KEY=
FINRA_API_KEY=
SESSION_SECRET=dev-only-change-me
# WebAuthn relying party (SEC-02). These are NEVER derived from the request's Host/Origin:
# the two anti-phishing checks of the ceremony compare against them, so a header-derived
# value would compare an attacker's value with itself. Unset, /auth/webauthn/* fails closed.
RP_ID=localhost
RP_ORIGIN=http://localhost:5173
CONFLATION_MS_DEFAULT=250
LOG_LEVEL=info
# GET /metrics (API.md §5.15) is public on loopback and needs this bearer token from anywhere
# else. Left unset, a non-loopback scrape is refused rather than served: fail closed.
METRICS_TOKEN=
# '1' serves the field dictionary (GET /fields, /fields/:id, /fields/changelog) without a session
# (API.md §5.5). It is documentation — definitions, units and licence terms, no values — but it is
# off unless a deployment says otherwise.
PUBLIC_FIELDS=0
